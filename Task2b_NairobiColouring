    'Makadara':         ['Embakasi Central', 'Embakasi West', 'Kamukunji', 'Starehe'],
    'Kamukunji':        ['Kibra', 'Embakasi West', 'Makadara', 'Starehe'],
    'Starehe':          ['Westlands', 'Dagoretti North', 'Kibra', 'Roysambu', 'Kamukunji', 'Makadara', 'Mathare'],
    'Mathare':          ['Kasarani', 'Ruaraka', 'Embakasi North', 'Starehe']
}


def is_valid(region, colour, assignment, neighbours):
    for neighbour in neighbours[region]:
        if neighbour in assignment:
            if assignment[neighbour] == colour:
                return False
    return True

# Using Backtracking to solve

def solve(regions, neighbours, colours, assignment):
    if len(assignment) == len(regions):
        return assignment
    unassigned = [r for r in regions if r not in assignment]
    region = unassigned[0]
    for colour in colours:
        if is_valid(region, colour, assignment, neighbours):
            assignment[region] = colour
            result = solve(regions, neighbours, colours, assignment)
            if result:
                return result
            del assignment[region]
    return None

# Find minimum colours needed

def solve_with_minimum_colours(regions, neighbours):
    for num_colours in range(3, len(regions) + 1):
        colours = [f'Colour{i+1}' for i in range(num_colours)]
        assignment = {}
        result = solve(regions, neighbours, colours, assignment)
        if result:
            return result, colours
    return None, None 

