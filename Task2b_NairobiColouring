regions = [
    'Westlands', 'Dagoretti North', 'Dagoretti South',
    'Langata', 'Kibra', 'Roysambu', 'Kasarani',
    'Ruaraka', 'Embakasi South', 'Embakasi North',
    'Embakasi Central', 'Embakasi East', 'Embakasi West',
    'Makadara', 'Kamukunji', 'Starehe', 'Mathare'
]

# Sub-counties of Nairobi and their neighbours
neighbours = {
    'Westlands':        ['Roysambu', 'Kasarani', 'Starehe', 'Dagoretti North'],
    'Dagoretti North':  ['Westlands', 'Dagoretti South', 'Kibra', 'Starehe'],
    'Dagoretti South':  ['Dagoretti North', 'Langata', 'Kibra'],
    'Langata':          ['Dagoretti South', 'Kibra', 'Embakasi West'],
    'Kibra':            ['Dagoretti North', 'Dagoretti South', 'Langata', 'Starehe', 'Kamukunji'],
    'Roysambu':         ['Westlands', 'Kasarani', 'Ruaraka', 'Starehe'],
    'Kasarani':         ['Westlands', 'Roysambu', 'Ruaraka', 'Mathare'],
    'Ruaraka':          ['Roysambu', 'Kasarani', 'Mathare', 'Embakasi North'],
    'Embakasi South':   ['Embakasi West', 'Embakasi Central', 'Embakasi East'],
    'Embakasi North':   ['Ruaraka', 'Embakasi Central', 'Embakasi East', 'Mathare'],
    'Embakasi Central': ['Embakasi South', 'Embakasi North', 'Embakasi East', 'Embakasi West', 'Makadara'],
